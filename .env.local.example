# Stripe (test mode keys for local; live keys in Vercel for prod)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Cal.com REST v2
CAL_API_KEY=cal_xxx
CAL_API_BASE=https://api.cal.com/v2
CAL_API_VERSION=2024-09-04

# One Cal.com numeric event-type ID per studio set. Values come from the
# Cal.com dashboard → Event Types after creating one per set.
CAL_EVENT_TYPE_EXECUTIVE_PODCAST=
CAL_EVENT_TYPE_AUTHORITY_DESK=
CAL_EVENT_TYPE_AUTHORITY_CREATOR=
CAL_EVENT_TYPE_HORIZON_PODCAST=
CAL_EVENT_TYPE_HORIZON_DESK=
CAL_EVENT_TYPE_HORIZON_CREATOR=

# Cal.com event type ID for the free 15-min studio tour. Numeric ID from
# the Cal.com event-type edit URL.
CAL_EVENT_TYPE_TOUR=6123370

# Studio timezone used for all Cal.com slot rendering + booking start values.
STUDIO_TIMEZONE=America/New_York

# Meta Pixel ID from Events Manager. Exposed to the browser.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager container ID (format: GTM-XXXXXXX). Exposed to the browser.
NEXT_PUBLIC_GTM_ID=

# Public Cal.com link for the 15-min Voxa On-Site intro call. Example:
#   https://cal.com/voxastudios/onsite-15min
# Used by /onsite/* pages: secondary CTA + inline embed in the quote form's
# success state. If unset, the embed falls back to a placeholder.
NEXT_PUBLIC_CAL_ONSITE_LINK=

# Emails Voxa On-Site quote leads. Create a key at resend.com/api-keys, using a
# Resend account registered to the address that receives leads. Without this key
# the quote form returns an error in production so leads are never silently lost.
RESEND_API_KEY=
# Optional overrides. Defaults: voxastudiosfl@gmail.com, Resend's shared sender.
ONSITE_LEAD_EMAIL=
ONSITE_LEAD_FROM=
